# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
# .env.local is gitignored. Everything prefixed with VITE_ is bundled into the
# client JS and visible to anyone, so never put secrets (client secrets, API
# keys) here; those belong in backend/.env.

# Auth0 Dashboard > Applications > (your Single Page Application) > Settings
# "Domain", e.g. dev-abc123.us.auth0.com (no https://)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# "Client ID" (SPA apps have no client secret; don't add one)
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Auth0 Dashboard > Applications > APIs > (your API) > "Identifier"
# Must match the audience the backend validates tokens against.
VITE_AUTH0_AUDIENCE=https://loci-api

# Vite dev server port
PORT=5173
