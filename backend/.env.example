# Copy to backend/.env and fill in. .env is gitignored: never commit the real key.
GEMINI_API_KEY=
PORT=3001
# placeholder = free SVG sketches instead of pictures; gemini = real images (needs billing)
PICTURES=placeholder

# Auth0 (leave AUTH0_DOMAIN empty to run without login).
AUTH0_DOMAIN=dev-sknccm5343cwp4hh.us.auth0.com
# Optional: identifier of an Auth0 API. If set (here and as VITE_AUTH0_AUDIENCE in
# frontend/.env.local), tokens are verified as JWTs instead of via /userinfo.
AUTH0_AUDIENCE=
