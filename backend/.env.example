# Copy this file to .env (same folder) and fill it in. Never commit .env.

# Leave empty to use a local SQLite file (loci.db), which is fine for tonight.
# For Postgres (e.g. Neon), paste the connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth0 tenant (same domain as frontend/.env.local)
AUTH0_DOMAIN=dev-sknccm5343cwp4hh.us.auth0.com
# The "Identifier" of the API you create in Auth0 -> Applications -> APIs
AUTH0_AUDIENCE=https://loci-api

# true = skip Auth0 and use the X-Dev-User header (local testing only!)
DEV_AUTH=true

# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
