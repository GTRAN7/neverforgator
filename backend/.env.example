# Copy to backend/.env and fill in. .env is gitignored: never commit the real key.
GEMINI_API_KEY=
PORT=3001
# How stops get pictures: doodle (default) = Gemini draws a small SVG, works on the free tier;
# gemini = real images (needs billing); placeholder = free sketch cards, no API call
PICTURES=doodle
# Optional: pin a model instead of the newest flash (flash-lite has the biggest free quota)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Auth0 (leave AUTH0_DOMAIN empty to run without login).
AUTH0_DOMAIN=dev-sknccm5343cwp4hh.us.auth0.com
# Optional: identifier of an Auth0 API. If set (here and as VITE_AUTH0_AUDIENCE in
# frontend/.env.local), tokens are verified as JWTs instead of via /userinfo.
AUTH0_AUDIENCE=
